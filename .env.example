GITHUB_PAT=ghp_your_personal_access_token_here
ANSIBLE_HOST=xx.xx.xx.xx
ANSIBLE_USER=ubuntu
ANSIBLE_PASS=supersecretpassword
ANSIBLE_HOST_KEY_CHECKING=False
RUNNER_USER=runner
GITHUB_REPO_URL=https://github.com/StevenLie14/stevenlie
# HARBOR
HARBOR_HTTP_PORT=80
HARBOR_HTTPS_PORT=443
HARBOR_ADMIN_PASSWORD=Admin12345
REGISTRY_URL=registry.stevenlie.my.id
REGISTRY_USERNAME=your_registry_username
REGISTRY_PASSWORD=your_registry_password

# VAULT
VAULT_URL=https://vault.stevenlie.my.id
VAULT_USERNAME=your_vault_username
VAULT_PASSWORD=your_vault_password
VAULT_PATH=kv/data/repo_name

# FORGEJO
FORGEJO_DB_TYPE=postgres
FORGEJO_DB_HOST=db:5432
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWD=forgejo_pass

# FORGEJO SECRET
FORGEJO_URL=https://forgejo.slc.net
FORGEJO_ORG_NAME=slc-rdt
FORGEJO_TOKEN=FORGEJO_TOKEN
FORGEJO_RUNNER_TOKEN=FORGEJO_RUNNER_TOKEN

# FORGEJO MIRROR
GITHUB_USERNAME=SV24-1
MIRROR_INTERVAL=0h10m0s

# CERTBOT
CERTBOT_ADMIN_EMAIL=email@gmail.com
# CI RUNNER (forgejo-runner tag). For now the docker-dev host (10.22.64.192).
CI_RUNNER_HOST=
CI_RUNNER_USER=
# sudo password of CI_RUNNER_USER; leave empty if sudo needs none
CI_RUNNER_PASSWORD=

# DEPLOY TARGETS (deploy-target, forgejo-secret tags)
DEPLOY_ADMIN_USER=
# per-host login user; leave empty to use DEPLOY_ADMIN_USER
DEPLOY_USER_DOCKER_APPS=
DEPLOY_USER_GALAXION=
DEPLOY_USER_WEB_LINUX=
DEPLOY_USER_VEGETA=
# sudo password of DEPLOY_ADMIN_USER on each host; leave empty if sudo needs none
DEPLOY_PASSWORD_DOCKER_APPS=
DEPLOY_PASSWORD_GALAXION=
DEPLOY_PASSWORD_WEB_LINUX=
DEPLOY_PASSWORD_VEGETA=
DEPLOY_HOST_DOCKER_APPS=
DEPLOY_HOST_GALAXION=
DEPLOY_HOST_SYAHDAN=
DEPLOY_HOST_WEB_LINUX=
DEPLOY_HOST_VEGETA=
# Pull-only registry robot account used by the deploy user on each host
DEPLOY_REGISTRY_USERNAME=
DEPLOY_REGISTRY_PASSWORD=

# VAULT ADMIN (vault-approle tag only; do not keep it in .env afterwards)
VAULT_ADMIN_TOKEN=

# One-hour token from GitHub org settings > Actions > Runners > New runner.
# Only needed the first time run_github_sync_runner.bat registers the runner.
GITHUB_RUNNER_TOKEN=
