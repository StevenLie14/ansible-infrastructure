GITHUB_PAT=ghp_your_personal_access_token_here
ANSIBLE_HOST=xx.xx.xx.xx
ANSIBLE_USER=ubuntu
ANSIBLE_PASS=supersecretpassword
ANSIBLE_HOST_KEY_CHECKING=False
RUNNER_USER=runner
GITHUB_REPO_URL=https://github.com/StevenLie14/stevenlie
# HARBOR
HARBOR_HTTP_PORT=80
HARBOR_HTTPS_PORT=443
HARBOR_ADMIN_PASSWORD=Admin12345
REGISTRY_URL=registry.stevenlie.my.id
REGISTRY_USERNAME=your_registry_username
REGISTRY_PASSWORD=your_registry_password

# VAULT
VAULT_URL=https://vault.stevenlie.my.id
VAULT_USERNAME=your_vault_username
VAULT_PASSWORD=your_vault_password
VAULT_PATH=kv/data/repo_name

# FORGEJO
FORGEJO_DB_TYPE=postgres
FORGEJO_DB_HOST=db:5432
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWD=forgejo_pass